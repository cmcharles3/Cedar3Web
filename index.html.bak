   <!-- ================= MODAL: NEW / EDIT JOB TICKET ================= -->
<div id="modal-job" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-800 rounded-2xl max-w-xl w-full p-6 shadow-2xl border border-slate-200 dark:border-slate-700 max-h-[90vh] flex flex-col my-auto">
        <div class="flex justify-between items-center pb-3 border-b border-slate-200 dark:border-slate-700 mb-4">
            <h3 class="font-bold text-base text-slate-900 dark:text-white flex items-center gap-2">
                <i class="fa-solid fa-ticket text-emerald-600"></i> Workshop Job Ticket
            </h3>
            <button onclick="Jobs.closeJobModal()" class="text-slate-400 hover:text-slate-600 text-lg font-bold">&times;</button>
        </div>

        <!-- Scrollable Form Container to Prevent Overlapping -->
        <form id="job-form" onsubmit="Jobs.saveJob(event)" class="space-y-4 text-xs flex-1 overflow-y-auto pr-2 custom-scrollbar">
            <div>
                <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Client Name</label>
                <input type="text" id="job-customer" required placeholder="e.g. Metro Health / Sipho Khumalo" class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl p-2.5">
            </div>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Contact Phone</label>
                    <input type="text" id="job-phone" required placeholder="e.g. 083 456 7890" class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl p-2.5">
                </div>
                <div>
                    <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Assigned Technician</label>
                    <select id="job-assigned-tech" class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl p-2.5">
                        <option value="Receptionist">Receptionist (Lean)</option>
                        <option value="Talent">Talent</option>
                        <option value="Simba">Simba</option>
                    </select>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Machine Model</label>
                    <input type="text" id="job-device" required placeholder="e.g. Epson EcoTank L3150" class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl p-2.5">
                </div>
                <div>
                    <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Serial Number (S/N)</label>
                    <input type="text" id="job-sn" required placeholder="e.g. EP-3150-884920" class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl p-2.5">
                </div>
            </div>

            <div>
                <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Cables & Accessories Included</label>
                <input type="text" id="job-cables" placeholder="Power Cable, USB Cable" class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl p-2.5">
            </div>

            <div>
                <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Fault Description / Error Codes</label>
                <textarea id="job-faults" rows="2" required placeholder="Paper jam, red light flashing..." class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl p-2.5 resize-none"></textarea>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Job Stage</label>
                    <select id="job-status" class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl p-2.5">
                        <option value="Pending">Pending</option>
                        <option value="In Progress">In Progress</option>
                        <option value="On Hold">On Hold / Parts</option>
                        <option value="Completed">Completed</option>
                    </select>
                </div>
                <div>
                    <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Estimated Cost (ZAR)</label>
                    <input type="number" id="job-cost" value="450.00" step="0.01" class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl p-2.5">
                </div>
            </div>

                        <!-- 5. Intake Photos -->
            <div class="bg-slate-50 dark:bg-slate-900/80 p-3 rounded-xl border border-slate-200 dark:border-slate-700 space-y-2">
                <span class="font-bold text-slate-700 dark:text-slate-300 uppercase text-[10px] tracking-wider block">5. Intake Photos</span>
                <div id="photo-preview-grid" class="grid grid-cols-3 gap-2"></div>
                <div>
                    <label for="photo-input" class="cursor-pointer inline-flex items-center gap-2 bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 hover:bg-emerald-100 text-xs font-semibold px-3 py-2 rounded-lg transition">
                        <i class="fa-solid fa-camera"></i>
                        <span>Add Photo</span>
                    </label>
                    <input type="file" id="photo-input" accept="image/*" multiple class="hidden" onchange="Jobs.handlePhotoUpload(event)">
                    <span id="photo-upload-status" class="ml-2 text-[11px] text-slate-500 italic"></span>
                </div>
                <p class="text-[10px] text-slate-400">Photos are stored on the server and viewable on the job card. Max 10 MB per photo.</p>
            </div>
  
            <div class="pt-4 flex justify-end gap-2 border-t border-slate-200 dark:border-slate-700">
                <button type="button" onclick="Jobs.closeJobModal()" class="px-4 py-2 bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-200 font-bold rounded-xl">Cancel</button>
                <button type="submit" class="px-5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl shadow-md">Save Job Ticket</button>
            </div>
        </form>
    </div>
</div>

<!-- ================= MODAL: SERIAL NUMBER LOOKUP ================= -->
<div id="modal-sn-history" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-800 rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-slate-200 dark:border-slate-700 max-h-[85vh] flex flex-col my-auto">
        <div class="flex justify-between items-center pb-3 border-b border-slate-200 dark:border-slate-700 mb-4">
            <h3 class="font-bold text-base text-slate-900 dark:text-white flex items-center gap-2">
                <i class="fa-solid fa-magnifying-glass-location text-emerald-600"></i> Serial Number Search
            </h3>
            <button onclick="document.getElementById('modal-sn-history').classList.add('hidden')" class="text-slate-400 hover:text-slate-600 text-lg font-bold">&times;</button>
        </div>

        <div class="space-y-3 flex-1 flex flex-col overflow-hidden">
            <div class="flex gap-2">
                <input type="text" id="sn-search-query" onkeyup="Jobs.doSNLookup()" placeholder="Enter S/N, Client Name, or Phone..." class="flex-1 bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl p-2.5 text-xs font-semibold outline-none focus:ring-2 focus:ring-emerald-500">
                <button onclick="Jobs.doSNLookup()" class="bg-emerald-600 text-white px-4 py-2.5 rounded-xl text-xs font-bold shadow">Search</button>
            </div>

            <div id="sn-history-results" class="space-y-2 flex-1 overflow-y-auto custom-scrollbar pt-2">
                <p class="text-xs text-slate-400 italic text-center py-4">Enter a query above to search past repairs.</p>
            </div>
        </div>
    </div>
</div>

<!-- ========== MODAL: Invoice / Quote ========== -->
<div id="modal-invoice" class="fixed inset-0 bg-slate-900/70 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4 overflow-y-auto">
    <div class="bg-white text-slate-900 rounded-2xl max-w-2xl w-full p-8 shadow-2xl border border-slate-300 my-8">
        <div id="invoice-printable-area" class="space-y-5">
            <div class="flex justify-between items-start border-b-2 border-slate-900 pb-4">
                <div>
                    <h2 class="text-2xl font-black uppercase tracking-wide text-slate-900">Cedar3 Technology</h2>
                    <p class="text-xs font-bold text-slate-600">TAX INVOICE / OFFICIAL QUOTATION</p>
                    <p class="text-[11px] text-slate-500">Reg No: 2024/382910/07 | Email: cedar3tech@gmail.com</p>
                </div>
                <div class="text-right">
                    <span id="invoice-type-badge" class="inline-block px-3 py-1 bg-emerald-700 text-white font-mono font-bold text-sm rounded uppercase">TAX INVOICE</span>
                    <p id="invoice-doc-num" class="text-xs font-mono font-bold mt-1 text-slate-800">INV-JOB-101</p>
                    <p id="invoice-doc-date" class="text-xs font-mono text-slate-600">Date: 2026/02/21</p>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4 text-xs font-mono border border-slate-200 rounded-lg p-3 bg-slate-50">
                <div>
                    <p class="font-bold uppercase text-[10px] text-slate-500">Billed To:</p>
                    <p><strong id="inv-client-name" class="text-sm font-bold text-slate-900">-</strong></p>
                    <p id="inv-client-phone" class="text-slate-700">Phone: -</p>
                    <p id="inv-client-address" class="text-slate-700">Address: -</p>
                </div>
                <div class="text-right">
                    <p class="font-bold uppercase text-[10px] text-slate-500">Hardware Reference:</p>
                    <p id="inv-device-model" class="font-bold text-slate-900">-</p>
                    <p id="inv-sn" class="text-slate-700">S/N: -</p>
                    <p id="inv-assigned-tech" class="text-slate-700">Tech: -</p>
                </div>
            </div>

            <div class="border border-slate-300 rounded-lg overflow-hidden text-xs">
                <table class="w-full text-left font-mono">
                    <thead class="bg-slate-100 border-b border-slate-300 font-bold uppercase text-[10px]">
                        <tr>
                            <th class="p-2.5">Description</th>
                            <th class="p-2.5 text-right">Amount (ZAR)</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200">
                        <tr>
                            <td class="p-2.5">
                                <p class="font-bold text-slate-900" id="inv-line-service">Workshop Diagnostic & Repair Labor</p>
                                <p class="text-[11px] text-slate-500" id="inv-line-tech-notes">-</p>
                            </td>
                            <td class="p-2.5 text-right font-bold text-slate-900" id="inv-labor-cost">R0.00</td>
                        </tr>
                        <tr>
                            <td class="p-2.5">
                                <p class="font-bold text-slate-900">Replacement Parts & Materials</p>
                                <p class="text-[11px] text-slate-500" id="inv-line-parts">-</p>
                            </td>
                            <td class="p-2.5 text-right font-bold text-slate-900">Included</td>
                        </tr>
                    </tbody>
                    <tfoot class="bg-slate-50 border-t border-slate-300 font-bold">
                        <tr>
                            <td class="p-2.5 text-right uppercase text-slate-700">Total Amount Due:</td>
                            <td class="p-2.5 text-right text-base text-emerald-800" id="inv-total-amount">R0.00</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="border-2 border-dashed border-emerald-600 rounded-xl p-4 bg-emerald-50/50 text-xs font-mono space-y-1.5">
                <div class="flex items-center gap-2 font-bold text-emerald-900 uppercase text-[11px]">
                    <i class="fa-solid fa-building-columns text-emerald-700"></i>
                    <span>Cedar3 Technology Banking Details for EFT Payments:</span>
                </div>
                <div class="grid grid-cols-2 gap-2 text-[11px] text-slate-800 pt-1">
                    <p><strong>Bank:</strong> First National Bank (FNB)</p>
                    <p><strong>Account Type:</strong> Business Cheque</p>
                    <p><strong>Account Number:</strong> 6289 1042 981</p>
                    <p><strong>Branch Code:</strong> 250655</p>
                    <p class="col-span-2"><strong>Payment Reference:</strong> <span id="inv-bank-ref" class="text-emerald-800 font-bold underline">JOB-101</span></p>
                </div>
                <p class="text-[10px] text-slate-500 italic pt-1 border-t border-emerald-200">Please email proof of payment to cedar3tech@gmail.com using the job reference above.</p>
            </div>
        </div>

        <div class="mt-4 p-3 bg-blue-50 rounded-xl border border-blue-200 flex items-center justify-between text-xs font-mono">
            <div class="flex items-center gap-2 text-blue-900 font-semibold">
                <i class="fa-solid fa-receipt text-blue-600 text-base"></i>
                <span>Express Invoice Bridge</span>
            </div>
            <div class="flex items-center gap-2">
                <button onclick="Jobs.copyInvoiceText()" class="px-2.5 py-1 bg-white border border-blue-300 hover:bg-blue-100 text-blue-800 font-bold rounded text-[11px] flex items-center gap-1">
                    <i class="fa-solid fa-copy"></i> Copy Data
                </button>
            </div>
        </div>

        <div class="mt-4 border-t pt-4 flex flex-wrap justify-between items-center gap-2">
            <div class="flex items-center gap-2">
                <button onclick="Jobs.setInvoiceMode('INVOICE')" id="btn-toggle-invoice" class="px-3 py-1.5 rounded-lg bg-emerald-600 text-white text-xs font-bold">Tax Invoice</button>
                <button onclick="Jobs.setInvoiceMode('QUOTE')" id="btn-toggle-quote" class="px-3 py-1.5 rounded-lg bg-slate-200 text-slate-800 text-xs font-bold">Quotation</button>
            </div>
            <div class="flex items-center gap-2">
                <button onclick="document.getElementById('modal-invoice').classList.add('hidden')" class="px-3.5 py-2 rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-800 font-semibold text-xs">Close</button>
                <button onclick="Jobs.sendInvoiceWhatsApp()" class="px-3.5 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs flex items-center gap-1.5">
                    <i class="fa-brands fa-whatsapp text-sm"></i> Send via WhatsApp
                </button>
                <button onclick="window.print()" class="px-4 py-2 rounded-lg bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs flex items-center gap-1.5 shadow-md">
                    <i class="fa-solid fa-print"></i> Print
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ========== MODAL: Job Create / Edit ========== -->
<div id="modal-job" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4 overflow-y-auto">
    <div class="bg-white dark:bg-slate-800 rounded-2xl max-w-xl w-full p-6 shadow-2xl border border-slate-200 dark:border-slate-700 my-8">
        <div class="flex justify-between items-center mb-4 pb-3 border-b border-slate-200 dark:border-slate-700">
            <div>
                <h3 id="job-modal-title" class="font-bold text-base text-slate-900 dark:text-white flex items-center gap-2">
                    <i class="fa-solid fa-file-invoice text-emerald-600"></i> New Job Ticket
                </h3>
                <p class="text-xs text-slate-500">Cedar3 Technology Hardware Intake</p>
            </div>
            <button onclick="Jobs.closeJobModal()" class="text-slate-400 hover:text-slate-600">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>
        </div>

        <form id="job-form" onsubmit="Jobs.saveJob(event)" class="space-y-3 text-xs">
            <input type="hidden" id="job-id">

            <!-- Client -->
            <div class="bg-slate-50 dark:bg-slate-900/80 p-3 rounded-xl border border-slate-200 dark:border-slate-700 space-y-2">
                <span class="font-bold text-slate-700 dark:text-slate-300 uppercase text-[10px] tracking-wider block">1. Client Information</span>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block font-semibold mb-1">Client's Name</label>
                        <input type="text" id="job-customer" required placeholder="e.g. Apex Logistics"
                               class="w-full bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg p-2 outline-none focus:ring-2 focus:ring-emerald-500">
                    </div>
                    <div>
                        <label class="block font-semibold mb-1">Contact No</label>
                        <input type="text" id="job-phone" placeholder="e.g. 082 123 4567"
                               class="w-full bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg p-2 outline-none focus:ring-2 focus:ring-emerald-500">
                    </div>
                </div>
                <div>
                    <label class="block font-semibold mb-1">Address</label>
                    <input type="text" id="job-address" placeholder="e.g. 14 Cedar Avenue, Midrand"
                           class="w-full bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg p-2 outline-none focus:ring-2 focus:ring-emerald-500">
                </div>
            </div>

            <!-- Hardware -->
            <div class="bg-slate-50 dark:bg-slate-900/80 p-3 rounded-xl border border-slate-200 dark:border-slate-700 space-y-2">
                <span class="font-bold text-slate-700 dark:text-slate-300 uppercase text-[10px] tracking-wider block">2. Machine Specifications</span>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block font-semibold mb-1">Machine Model No.</label>
                        <input type="text" id="job-device" required placeholder="e.g. Epson EcoTank L3150"
                               class="w-full bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg p-2 outline-none focus:ring-2 focus:ring-emerald-500">
                    </div>
                    <div>
                        <label class="block font-semibold mb-1">Serial Number (S/N)</label>
                        <input type="text" id="job-sn" placeholder="e.g. X9YK084920"
                               class="w-full bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg p-2 outline-none focus:ring-2 focus:ring-emerald-500 font-mono">
                    </div>
                </div>
                <div>
                    <label class="block font-semibold mb-1">Cables & Accessories Included</label>
                    <input type="text" id="job-cables" placeholder="e.g. Power Cable, USB Cable"
                           class="w-full bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg p-2 outline-none focus:ring-2 focus:ring-emerald-500">
                </div>
            </div>

            <!-- Faults & Assignment -->
            <div class="bg-slate-50 dark:bg-slate-900/80 p-3 rounded-xl border border-slate-200 dark:border-slate-700 space-y-2">
                <span class="font-bold text-slate-700 dark:text-slate-300 uppercase text-[10px] tracking-wider block">3. Faults & Assignment</span>
                <div>
                    <label class="block font-semibold mb-1">Faults / Error Codes</label>
                    <textarea id="job-faults" rows="2" placeholder="e.g. Paper Jam / Error E-04 / Red light"
                              class="w-full bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg p-2 outline-none focus:ring-2 focus:ring-emerald-500 font-mono"></textarea>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block font-semibold mb-1">Assigned Technician</label>
                        <select id="job-assigned-tech" class="w-full bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg p-2 outline-none">
                            <option value="Receptionist">Receptionist</option>
                            <option value="Talent">Talent</option>
                            <option value="Simba">Simba</option>
                        </select>
                    </div>
                    <div>
                        <label class="block font-semibold mb-1">Priority</label>
                        <select id="job-priority" class="w-full bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg p-2 outline-none">
                            <option value="Normal">Normal</option>
                            <option value="High">High</option>
                            <option value="Urgent">Urgent</option>
                        </select>
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block font-semibold mb-1">Job Stage</label>
                        <select id="job-status" class="w-full bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg p-2 outline-none">
                            <option value="Pending">Pending</option>
                            <option value="In Progress">In Progress</option>
                            <option value="On Hold">On Hold</option>
                            <option value="Completed">Completed</option>
                        </select>
                    </div>
                    <div>
                        <label class="block font-semibold mb-1">Follow-Up</label>
                        <select id="job-followup" class="w-full bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg p-2 outline-none">
                            <option value="Client Notified">Client Notified</option>
                            <option value="Needs Call">Needs Call</option>
                            <option value="Waiting Parts">Waiting Parts</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Report & Cost -->
            <div class="bg-slate-50 dark:bg-slate-900/80 p-3 rounded-xl border border-slate-200 dark:border-slate-700 space-y-2">
                <span class="font-bold text-slate-700 dark:text-slate-300 uppercase text-[10px] tracking-wider block">4. Report & Billing</span>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block font-semibold mb-1">Work Report</label>
                        <textarea id="job-tech-report" rows="2" placeholder="What was done..."
                                  class="w-full bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg p-2 outline-none focus:ring-2 focus:ring-emerald-500 font-mono"></textarea>
                    </div>
                    <div>
                        <label class="block font-semibold mb-1">Parts Needed</label>
                        <textarea id="job-parts-needed" rows="2" placeholder="e.g. 1x Pickup Roller"
                                  class="w-full bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg p-2 outline-none focus:ring-2 focus:ring-emerald-500 font-mono"></textarea>
                    </div>
                </div>
                <div>
                    <label class="block font-semibold mb-1">Total Cost (ZAR R)</label>
                    <input type="number" step="0.01" id="job-cost" placeholder="0.00"
                           class="w-full bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg p-2 outline-none focus:ring-2 focus:ring-emerald-500 font-bold text-emerald-600">
                </div>
            </div>

                        <!-- 5. Intake Photos -->
            <div class="bg-slate-50 dark:bg-slate-900/80 p-3 rounded-xl border border-slate-200 dark:border-slate-700 space-y-2">
                <span class="font-bold text-slate-700 dark:text-slate-300 uppercase text-[10px] tracking-wider block">5. Intake Photos</span>
                <div id="photo-preview-grid" class="grid grid-cols-3 gap-2"></div>
                <div>
                    <label for="photo-input" class="cursor-pointer inline-flex items-center gap-2 bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 hover:bg-emerald-100 text-xs font-semibold px-3 py-2 rounded-lg transition">
                        <i class="fa-solid fa-camera"></i>
                        <span>Add Photo</span>
                    </label>
                    <input type="file" id="photo-input" accept="image/*" multiple class="hidden" onchange="Jobs.handlePhotoUpload(event)">
                    <span id="photo-upload-status" class="ml-2 text-[11px] text-slate-500 italic"></span>
                </div>
                <p class="text-[10px] text-slate-400">Photos are stored on the server and viewable on the job card. Max 10 MB per photo.</p>
            </div>

            <div class="pt-2 flex justify-end space-x-2">
                <button type="button" onclick="Jobs.closeJobModal()" class="px-4 py-2 rounded-lg bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 font-semibold">Cancel</button>
                <button type="submit" class="bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-4 py-2 rounded-lg shadow-sm">Save Job Card</button>
            </div>

            <!-- Photos -->
            <div class="bg-slate-50 dark:bg-slate-900/80 p-3 rounded-xl border border-slate-200 dark:border-slate-700 space-y-2">
                <span class="font-bold text-slate-700 dark:text-slate-300 uppercase text-[10px] tracking-wider block">5. Intake Photos</span>
                <div id="photo-preview-grid" class="grid grid-cols-3 gap-2"></div>
                <div>
                    <label for="photo-input" class="cursor-pointer inline-flex items-center gap-2 bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 hover:bg-emerald-100 text-xs font-semibold px-3 py-2 rounded-lg transition">
                        <i class="fa-solid fa-camera"></i>
                        <span>Add Photo</span>
                    </label>
                    <input type="file" id="photo-input" accept="image/*" multiple class="hidden" onchange="Jobs.handlePhotoUpload(event)">
                    <span id="photo-upload-status" class="ml-2 text-[11px] text-slate-500 italic"></span>
                </div>
                <p class="text-[10px] text-slate-400">Photos are stored on the server and viewable on the job card. Max 10 MB per photo.</p>
            </div>
        </form>
    </div>
</div>

<!-- ========== MODAL: S/N Lookup ========== -->
<div id="modal-sn-history" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-800 rounded-2xl max-w-2xl w-full p-6 shadow-2xl border border-slate-200 dark:border-slate-700 max-h-[85vh] flex flex-col">
        <div class="flex justify-between items-center pb-3 border-b border-slate-200 dark:border-slate-700">
            <div>
                <h3 class="font-bold text-base text-slate-900 dark:text-white flex items-center gap-2">
                    <i class="fa-solid fa-magnifying-glass-location text-emerald-600"></i> Repair History Lookup
                </h3>
                <p class="text-xs text-slate-500">Search by S/N, phone, client name, or device.</p>
            </div>
            <button onclick="document.getElementById('modal-sn-history').classList.add('hidden')" class="text-slate-400 hover:text-slate-600">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>
        </div>

        <div class="py-4 space-y-3">
            <div class="flex gap-2">
                <input type="text" id="sn-search-query" onkeyup="if(event.key === 'Enter') Jobs.doSNLookup()"
                       placeholder="Serial number, phone, or client name..."
                       class="flex-1 bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl p-2.5 text-xs outline-none focus:ring-2 focus:ring-emerald-500 font-mono">
                <button onclick="Jobs.doSNLookup()" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-4 py-2.5 rounded-xl text-xs flex items-center gap-1.5">
                    <i class="fa-solid fa-search"></i> Lookup
                </button>
            </div>
        </div>

        <div id="sn-history-results" class="flex-1 overflow-y-auto space-y-3 custom-scrollbar pr-1"></div>
    </div>
</div>

<!-- Toast container -->
<!-- MODAL: Inventory Add / Edit -->
<div id="modal-inv-item" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4 overflow-y-auto">
    <div class="bg-white dark:bg-slate-800 rounded-2xl max-w-xl w-full p-6 shadow-2xl border border-slate-200 dark:border-slate-700 my-8">
        <div class="flex justify-between items-center mb-4 pb-3 border-b border-slate-200 dark:border-slate-700">
            <h3 id="inv-item-modal-title" class="font-bold text-base text-slate-900 dark:text-white flex items-center gap-2"><i class="fa-solid fa-boxes-stacked text-emerald-600"></i> New Item</h3>
            <button onclick="document.getElementById('modal-inv-item').classList.add('hidden')" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-xmark text-lg"></i></button>
        </div>
        <form id="inv-item-form" onsubmit="Inventory.saveItem(event)" class="space-y-3 text-xs">
            <input type="hidden" id="inv-item-id">
            <div class="grid grid-cols-2 gap-3">
                <div><label class="block font-semibold mb-1">SKU *</label><input type="text" id="inv-item-sku" required class="w-full bg-white dark:bg-slate-800 border rounded-lg p-2 font-mono"></div>
                <div><label class="block font-semibold mb-1">Category</label><select id="inv-item-category" class="w-full bg-white dark:bg-slate-800 border rounded-lg p-2"><option>Ink</option><option>Parts</option><option>Components</option><option>Cables</option><option>Devices</option><option>Consumables</option><option>Other</option></select></div>
            </div>
            <div><label class="block font-semibold mb-1">Item Name *</label><input type="text" id="inv-item-name" required class="w-full bg-white dark:bg-slate-800 border rounded-lg p-2"></div>
            <div class="grid grid-cols-3 gap-3">
                <div><label class="block font-semibold mb-1">Qty</label><input type="number" id="inv-item-qty" min="0" value="0" class="w-full bg-white dark:bg-slate-800 border rounded-lg p-2"></div>
                <div><label class="block font-semibold mb-1">Min Qty</label><input type="number" id="inv-item-minqty" min="0" value="3" class="w-full bg-white dark:bg-slate-800 border rounded-lg p-2"></div>
                <div><label class="block font-semibold mb-1">Unit</label><input type="text" id="inv-item-unit" value="each" class="w-full bg-white dark:bg-slate-800 border rounded-lg p-2"></div>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div><label class="block font-semibold mb-1">Cost Price</label><input type="number" step="0.01" id="inv-item-cost" value="0" class="w-full bg-white dark:bg-slate-800 border rounded-lg p-2"></div>
                <div><label class="block font-semibold mb-1">Sell Price</label><input type="number" step="0.01" id="inv-item-sell" value="0" class="w-full bg-white dark:bg-slate-800 border rounded-lg p-2"></div>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div><label class="block font-semibold mb-1">Supplier</label><input type="text" id="inv-item-supplier" class="w-full bg-white dark:bg-slate-800 border rounded-lg p-2"></div>
                <div><label class="block font-semibold mb-1">Location</label><input type="text" id="inv-item-location" class="w-full bg-white dark:bg-slate-800 border rounded-lg p-2"></div>
            </div>
            <div><label class="block font-semibold mb-1">Notes</label><textarea id="inv-item-notes" rows="2" class="w-full bg-white dark:bg-slate-800 border rounded-lg p-2 font-mono"></textarea></div>
            <div class="pt-2 flex justify-end space-x-2"><button type="button" onclick="document.getElementById('modal-inv-item').classList.add('hidden')" class="px-4 py-2 rounded-lg bg-slate-100 dark:bg-slate-700 font-semibold">Cancel</button><button type="submit" class="bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-4 py-2 rounded-lg">Save</button></div>
        </form>
    </div>
</div>

<!-- MODAL: Restock -->
<div id="modal-inv-restock" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-800 rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-200 dark:border-slate-700">
        <div class="flex justify-between items-center mb-4 pb-3 border-b"><h3 class="font-bold text-base text-slate-900 dark:text-white flex items-center gap-2"><i class="fa-solid fa-truck-arrow-right text-blue-600"></i> Restock</h3><button onclick="document.getElementById('modal-inv-restock').classList.add('hidden')" class="text-slate-400"><i class="fa-solid fa-xmark"></i></button></div>
        <p id="inv-restock-item-name" class="text-xs text-slate-500 mb-3"></p>
        <form onsubmit="Inventory.submitRestock(event)" class="space-y-3 text-xs">
            <input type="hidden" id="inv-restock-id">
            <div><label class="block font-semibold mb-1">Quantity to Add *</label><input type="number" id="inv-restock-qty" required min="1" value="1" class="w-full bg-white dark:bg-slate-800 border rounded-lg p-2"></div>
            <div><label class="block font-semibold mb-1">Unit Cost</label><input type="number" step="0.01" id="inv-restock-cost" class="w-full bg-white dark:bg-slate-800 border rounded-lg p-2"></div>
            <div class="grid grid-cols-2 gap-3"><div><label class="block font-semibold mb-1">Supplier</label><input type="text" id="inv-restock-supplier" class="w-full bg-white dark:bg-slate-800 border rounded-lg p-2"></div><div><label class="block font-semibold mb-1">Invoice #</label><input type="text" id="inv-restock-invoice" class="w-full bg-white dark:bg-slate-800 border rounded-lg p-2 font-mono"></div></div>
            <div class="pt-2 flex justify-end space-x-2"><button type="button" onclick="document.getElementById('modal-inv-restock').classList.add('hidden')" class="px-4 py-2 rounded-lg bg-slate-100 dark:bg-slate-700 font-semibold">Cancel</button><button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-4 py-2 rounded-lg">Restock</button></div>
        </form>
    </div>
</div>

<!-- MODAL: Sell -->
<div id="modal-inv-sell" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-800 rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-200 dark:border-slate-700">
        <div class="flex justify-between items-center mb-4 pb-3 border-b"><h3 class="font-bold text-base text-slate-900 dark:text-white flex items-center gap-2"><i class="fa-solid fa-cart-shopping text-emerald-600"></i> Sell / Use</h3><button onclick="document.getElementById('modal-inv-sell').classList.add('hidden')" class="text-slate-400"><i class="fa-solid fa-xmark"></i></button></div>
        <p id="inv-sell-item-name" class="text-xs text-slate-500 mb-3"></p>
        <form onsubmit="Inventory.submitSell(event)" class="space-y-3 text-xs">
            <input type="hidden" id="inv-sell-id">
            <div><label class="block font-semibold mb-1">Type</label><select id="inv-sell-type" onchange="Inventory.onSellTypeChange()" class="w-full bg-white dark:bg-slate-800 border rounded-lg p-2"><option value="sale">Sale</option><option value="repair-use">Repair Use</option></select></div>
            <div><label class="block font-semibold mb-1">Qty</label><input type="number" id="inv-sell-qty" required min="1" value="1" class="w-full bg-white dark:bg-slate-800 border rounded-lg p-2"></div>
            <div><label class="block font-semibold mb-1">Unit Price</label><input type="number" step="0.01" id="inv-sell-price" class="w-full bg-white dark:bg-slate-800 border rounded-lg p-2"></div>
            <div id="inv-sell-client-row"><label class="block font-semibold mb-1">Client</label><input type="text" id="inv-sell-client" class="w-full bg-white dark:bg-slate-800 border rounded-lg p-2"></div>
            <div><label class="block font-semibold mb-1">Job Ref</label><input type="text" id="inv-sell-job" class="w-full bg-white dark:bg-slate-800 border rounded-lg p-2 font-mono"></div>
            <div class="pt-2 flex justify-end space-x-2"><button type="button" onclick="document.getElementById('modal-inv-sell').classList.add('hidden')" class="px-4 py-2 rounded-lg bg-slate-100 dark:bg-slate-700 font-semibold">Cancel</button><button type="submit" class="bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-4 py-2 rounded-lg">Confirm</button></div>
        </form>
    </div>
</div>

<!-- MODAL: Reconcile -->
<div id="modal-inv-reconcile" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-800 rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-200 dark:border-slate-700">
        <div class="flex justify-between items-center mb-4 pb-3 border-b"><h3 class="font-bold text-base text-slate-900 dark:text-white flex items-center gap-2"><i class="fa-solid fa-clipboard-check text-amber-600"></i> Reconcile</h3><button onclick="document.getElementById('modal-inv-reconcile').classList.add('hidden')" class="text-slate-400"><i class="fa-solid fa-xmark"></i></button></div>
        <p id="inv-reconcile-item-name" class="text-xs text-slate-500 mb-3"></p>
        <form onsubmit="Inventory.submitReconcile(event)" class="space-y-3 text-xs">
            <input type="hidden" id="inv-reconcile-id">
            <div><label class="block font-semibold mb-1">Physical Count</label><input type="number" id="inv-reconcile-count" required min="0" class="w-full bg-white dark:bg-slate-800 border rounded-lg p-2"><p id="inv-reconcile-hint" class="text-[10px] text-slate-400 mt-1"></p></div>
            <div><label class="block font-semibold mb-1">Note</label><textarea id="inv-reconcile-note" rows="2" class="w-full bg-white dark:bg-slate-800 border rounded-lg p-2 font-mono"></textarea></div>
            <div class="pt-2 flex justify-end space-x-2"><button type="button" onclick="document.getElementById('modal-inv-reconcile').classList.add('hidden')" class="px-4 py-2 rounded-lg bg-slate-100 dark:bg-slate-700 font-semibold">Cancel</button><button type="submit" class="bg-amber-600 hover:bg-amber-700 text-white font-semibold px-4 py-2 rounded-lg">Reconcile</button></div>
        </form>
    </div>
</div>
<div id="toast-container" class="fixed bottom-5 right-5 z-50 flex flex-col space-y-2 pointer-events-none"></div>
</body>
</html>


