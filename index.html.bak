            <i class="fa-solid fa-calendar-check mb-0.5 block"></i> Schedule
        </button>
        <button onclick="App.switchTab('clockin'); ClockIn.refresh();" data-tab="clockin"
            class="mobile-nav-btn flex-1 py-2 text-[10px] font-semibold text-center rounded-md text-slate-600 dark:text-slate-400">
