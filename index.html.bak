<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cedar3 Technology - Workshop Manager</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0fdf4', 100: '#dcfce7', 500: '#22c55e',
                            600: '#16a34a', 700: '#15803d', 800: '#166534', 900: '#14532d'
                        }
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="styles/app.css">
    <link rel="icon" href="data:,">
    

</head>
<body class="bg-slate-100 dark:bg-slate-900 text-slate-800 dark:text-slate-100 min-h-screen flex flex-col pb-16 md:pb-0 transition-colors duration-200">

    <!-- ================= HEADER ================= -->
    <header class="bg-white dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700 sticky top-0 z-30 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">

                <!-- Brand -->
                <div class="flex items-center space-x-3">
                    <div class="p-2 bg-emerald-600 text-white rounded-lg shadow-md">
                        <i class="fa-solid font-bold fa-screwdriver-wrench text-xl"></i>
                    </div>
                    <div>
                        <div class="flex items-center space-x-2">
                            <h1 class="font-bold text-lg leading-tight text-slate-900 dark:text-white">Cedar3 Technology</h1>
                            <span id="conn-badge" class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-amber-100 text-amber-800 border border-amber-200">
                                <span id="conn-dot" class="w-1.5 h-1.5 rounded-full conn-checking"></span>
                                <span id="conn-text">Connecting...</span>
                            </span>
                        </div>
                        <p class="text-xs text-slate-500 dark:text-slate-400">Workshop Remote Management & Job Tracker</p>
                    </div>
                </div>

                <!-- Nav Tabs -->
                <nav class="hidden md:flex space-x-1 bg-slate-100 dark:bg-slate-900/60 p-1 rounded-xl overflow-x-auto custom-scrollbar max-w-[600px] flex-shrink-0">
                    <button onclick="App.switchTab('dashboard')" data-tab="dashboard" class="nav-btn px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-150 flex items-center space-x-2 bg-white dark:bg-slate-800 text-emerald-600 dark:text-emerald-400 shadow-sm">
                        <i class="fa-solid fa-gauge-high"></i><span>Dashboard</span>
                    </button>

                    <!-- Frontend — Schedule Tab & Reminders -->
                    <button onclick="App.switchTab('schedule')" data-tab="schedule" class="nav-btn px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-150 flex items-center space-x-2 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white relative">
                        <i class="fa-solid fa-calendar-check"></i>
                        <span>Schedule</span>
                        <span id="schedule-badge" class="hidden absolute -top-1 -right-1 bg-rose-600 text-white text-[9px] font-bold rounded-full px-1.5 py-0.5">0</span>
                    </button>

                    <button onclick="App.switchTab('clockin')" data-tab="clockin" class="nav-btn px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-150 flex items-center space-x-2 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white">
                        <i class="fa-solid fa-clock"></i><span>Tech Clock-In</span>
                    </button>
                    <button onclick="App.switchTab('jobs'); Jobs.render();" data-tab="jobs" class="nav-btn px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-150 flex items-center space-x-2 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white">
                        <i class="fa-solid fa-list-check"></i><span>Active Jobs</span>
                    </button>
                    <button onclick="App.switchTab('logs'); Logs.render();" data-tab="logs" class="nav-btn px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-150 flex items-center space-x-2 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white">
                        <i class="fa-solid fa-file-invoice-dollar"></i><span>Payroll</span>
                    </button>
                </nav>
                    <button onclick="App.switchTab('inventory')" data-tab="inventory" class="nav-btn px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-150 flex items-center space-x-2 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white relative">
                        <i class="fa-solid fa-boxes-stacked"></i>
                        <span>Stock</span>
                        <span id="low-stock-badge" class="hidden absolute -top-1 -right-1 bg-rose-600 text-white text-[9px] font-bold rounded-full px-1.5 py-0.5">0</span>
                    </button>
                    

                <!-- Right Actions -->
                <div class="flex items-center space-x-2.5">
                    <div id="user-chip" class="hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-700 border border-slate-200 dark:border-slate-600">
                        <i id="user-chip-icon" class="fa-solid fa-user-shield text-amber-500"></i>
                        <div class="text-[11px] leading-tight">
                            <p id="user-chip-name" class="font-bold text-slate-900 dark:text-white">-</p>
                            <p id="user-chip-role" class="text-slate-500 dark:text-slate-400">-</p>
                        </div>
                    </div>

                    <button onclick="Jobs.openSNLookup()" title="S/N & Repair History Lookup"
                        class="p-2 rounded-lg bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-300 hover:bg-emerald-100 transition flex items-center space-x-1.5 text-xs font-semibold">
                        <i class="fa-solid fa-magnifying-glass-location text-emerald-600"></i>
                        
                    </button>

                    <button onclick="Jobs.openCreate()"
                        class="bg-emerald-600 hover:bg-emerald-700 text-white px-3.5 py-2 rounded-lg text-sm font-semibold flex items-center space-x-2 shadow-sm transition">
                        <i class="fa-solid fa-plus"></i>
                        
                    </button>

                    <button onclick="App.toggleDarkMode()" title="Toggle Dark Mode" class="p-2 rounded-lg text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition">
                        <i class="fa-solid fa-moon dark:hidden text-lg"></i>
                        <i class="fa-solid fa-sun hidden dark:block text-lg"></i>
                    </button>

                    <button onclick="App.logout()" title="Sign Out" class="p-2 rounded-lg bg-rose-50 dark:bg-rose-950/50 border border-rose-200 dark:border-rose-800 text-rose-600 dark:text-rose-400 hover:bg-rose-100 transition flex items-center space-x-1.5 text-xs font-semibold">
                        <i class="fa-solid fa-right-from-bracket"></i>
                        
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- ================= MAIN CONTENT ================= -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-1 w-full">

        <!-- DASHBOARD TAB -->
        <section id="tab-dashboard" class="tab-content space-y-6">
            <div class="bg-gradient-to-r from-slate-900 via-slate-800 to-emerald-950 text-white p-6 rounded-2xl shadow-md border border-slate-700 relative overflow-hidden">
                <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <div>
                        <div class="flex items-center gap-2 mb-1">
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
                                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                                Real-Time Workshop Monitor
                            </span>
                            <span class="text-xs text-slate-400" id="dashboard-last-refresh">Live</span>
                        </div>
                        <h2 class="text-xl font-bold">Remote Workshop Dashboard</h2>
                        <p class="text-xs text-slate-300 mt-1">Monitoring live technician activity, reception intake, printer repairs, and workstation output remotely.</p>
                    </div>

                   <div class="flex flex-wrap gap-2">
                    <button onclick="Dashboard.downloadBackup()" title="Download database backup" class="bg-slate-700 hover:bg-slate-600 text-white text-xs font-bold px-3 py-2.5 rounded-xl transition shadow flex items-center gap-2">
                        <i class="fa-solid fa-download"></i>
                        <span class="hidden sm:inline">Backup</span>
                    </button>
                    <button onclick="Dashboard.triggerRestore()" title="Restore database from backup" class="bg-rose-900/50 hover:bg-rose-900 text-rose-200 text-xs font-bold px-3 py-2.5 rounded-xl transition shadow flex items-center gap-2 border border-rose-700/50">
                        <i class="fa-solid fa-upload"></i>
                        <span class="hidden sm:inline">Restore</span>
                    </button>
                    <button onclick="Dashboard.refresh()" class="bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold px-4 py-2.5 rounded-xl transition shadow flex items-center gap-2">
                        <i class="fa-solid fa-rotate"></i>
                        <span>Refresh</span>
                    </button>
                </div>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6" id="dashboard-cards"></div>

            <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm space-y-4">
                <h3 class="font-bold text-base text-slate-900 dark:text-white flex items-center gap-2">
                    <i class="fa-solid fa-stream text-emerald-600"></i>
                    Workshop Activity & Audit Stream
                    <span class="text-[10px] font-normal text-slate-400 ml-auto" id="activity-count">-</span>
                </h3>
                <div id="dash-activity-feed" class="space-y-3 text-xs custom-scrollbar overflow-y-auto max-h-[500px]">
                    <p class="text-slate-400 italic">Loading <activity class="..."></activity></p>
                </div>
            </div>
        </section>

        <!-- CLOCK-IN TAB -->
        <section id="tab-clockin" class="tab-content hidden space-y-6">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <div class="lg:col-span-2 bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm space-y-5">
                    <div class="flex justify-between items-center pb-3 border-b border-slate-200 dark:border-slate-700">
                        <div>
                            <h2 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
                                <i class="fa-solid fa-clock text-emerald-600"></i> Workstation Clock-In Terminal
                            </h2>
                            <p class="text-xs text-slate-500">Signed in as <span id="clock-greeting" class="font-bold text-slate-700 dark:text-slate-300">-</span>.</p>
                        </div>
                        <span id="clock-status-badge" class="px-3 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-400">READY TO CLOCK IN</span>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 uppercase mb-1">Staff Member</label>
                            <select id="tech-select" class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl p-3 text-sm font-semibold outline-none focus:ring-2 focus:ring-emerald-500 disabled:opacity-60">
                                <option>Loading...</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 uppercase mb-1">Target Job / Activity</label>
                            <select id="job-select" class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl p-3 text-sm outline-none focus:ring-2 focus:ring-emerald-500 disabled:opacity-60">
                                <option value="GENERAL">-- General Workshop Duty --</option>
                            </select>
                        </div>
                    </div>

                    <div class="flex flex-col sm:flex-row gap-3 pt-2">
                        <button id="btn-clock-in" onclick="ClockIn.clockIn()" class="flex-1 bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3.5 px-4 rounded-xl shadow-md transition flex items-center justify-center space-x-2 text-sm disabled:opacity-50">
                            <i class="fa-solid fa-play"></i><span>Clock In Shift</span>
                        </button>
                        <button id="btn-clock-out" onclick="ClockIn.clockOut()" disabled class="flex-1 bg-rose-600 hover:bg-rose-700 text-white font-bold py-3.5 px-4 rounded-xl shadow-md transition flex items-center justify-center space-x-2 text-sm disabled:opacity-50">
                            <i class="fa-solid fa-stop"></i><span>Clock Out Shift</span>
                        </button>
                    </div>

                    <div class="space-y-2 pt-2">
                        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 uppercase">Log Tasks / Repair Notes:</label>
                        <textarea id="task-notes" rows="6" disabled placeholder="Notes are enabled once you clock in." class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl p-3 text-xs focus:ring-2 focus:ring-emerald-500 outline-none resize-none font-mono disabled:opacity-60"></textarea>
                    </div>
                </div>

                <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm flex flex-col justify-between space-y-6">
                    <div>
                        <h3 class="font-bold text-sm uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-4">Live Active Session</h3>
                        <div class="bg-slate-50 dark:bg-slate-900/80 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 text-center space-y-2 mb-4">
                            <span class="text-xs font-semibold text-slate-400 uppercase tracking-widest block">Active Duration</span>
                            <div id="session-timer" class="text-3xl font-mono font-bold text-slate-900 dark:text-white">00:00:00</div>
                            <p id="session-since" class="text-[11px] text-slate-500">Not currently on shift</p>
                        </div>
                    </div>
                    <div class="p-4 bg-emerald-50 dark:bg-emerald-950/40 rounded-xl border border-emerald-200 dark:border-emerald-800 text-xs text-emerald-800 dark:text-emerald-300 space-y-1">
                        <p class="font-bold flex items-center gap-1.5"><i class="fa-solid fa-shield-halved"></i> Session Integrity</p>
                        <p class="text-[11px] leading-relaxed">Timestamps and job notes are synced in real time.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- KANBAN JOBS TAB -->
        <section id="tab-jobs" class="tab-content hidden space-y-6">
            <div class="bg-white dark:bg-slate-800 p-4 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm flex flex-col sm:flex-row justify-between items-center gap-4">
                <div class="flex items-center space-x-2 w-full sm:w-auto">
                    <div class="relative w-full sm:w-64">
                        <i class="fa-solid fa-magnifying-glass absolute left-3 top-3 text-slate-400 text-xs"></i>
                        <input type="text" id="job-search-input" onkeyup="Jobs.render()" placeholder="Search jobs, devices, clients, S/N..." class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg pl-8 pr-3 py-1.5 text-xs focus:ring-2 focus:ring-emerald-500 outline-none">
                    </div>
                    <select id="job-tech-filter" onchange="Jobs.render()" class="bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg px-3 py-1.5 text-xs outline-none">
                        <option value="ALL">All Staff</option>
                        <option value="Receptionist">Receptionist</option>
                        <option value="Talent">Talent</option>
                        <option value="Simba">Simba</option>
                    </select>
                </div>
                <div class="flex items-center gap-2">
                    <button onclick="Jobs.openSNLookup()" class="bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-300 text-xs font-semibold px-3 py-2 rounded-lg border border-emerald-200 dark:border-emerald-800 transition flex items-center gap-1.5">
                        <i class="fa-solid fa-magnifying-glass-location"></i> S/N Lookup
                    </button>
                    <button onclick="Jobs.openCreate()" class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold px-3 py-2 rounded-lg transition flex items-center gap-1.5 shadow-sm">
                        <i class="fa-solid fa-plus"></i> New Job Ticket
                    </button>
                    <button onclick="Jobs.refresh()" class="bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-semibold px-3 py-2 rounded-lg transition flex items-center gap-1.5">
                        <i class="fa-solid fa-rotate"></i> Refresh
                    </button>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                <div class="bg-slate-200/60 dark:bg-slate-800/50 p-4 rounded-xl border border-slate-200 dark:border-slate-700/60 flex flex-col min-h-[500px]">
                    <div class="flex justify-between items-center mb-3">
                        <h4 class="font-bold text-xs uppercase tracking-wider text-slate-600 dark:text-slate-400 flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-slate-400"></span> Pending</h4>
                        <span id="count-pending" class="px-2 py-0.5 rounded-full text-xs font-bold bg-slate-300 dark:bg-slate-700">0</span>
                    </div>
                    <div id="kanban-pending" class="space-y-3 flex-1 overflow-y-auto max-h-[650px]"></div>
                </div>

                <div class="bg-blue-50/50 dark:bg-slate-800/50 p-4 rounded-xl border border-blue-200/60 dark:border-slate-700/60 flex flex-col min-h-[500px]">
                    <div class="flex justify-between items-center mb-3">
                        <h4 class="font-bold text-xs uppercase tracking-wider text-blue-600 dark:text-blue-400 flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span> Under Repair</h4>
                        <span id="count-in-progress" class="px-2 py-0.5 rounded-full text-xs font-bold bg-blue-200 dark:bg-blue-900/60">0</span>
                    </div>
                    <div id="kanban-in-progress" class="space-y-3 flex-1 overflow-y-auto max-h-[650px]"></div>
                </div>

                <div class="bg-amber-50/50 dark:bg-slate-800/50 p-4 rounded-xl border border-amber-200/60 dark:border-slate-700/60 flex flex-col min-h-[500px]">
                    <div class="flex justify-between items-center mb-3">
                        <h4 class="font-bold text-xs uppercase tracking-wider text-amber-600 dark:text-amber-400 flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span> On Hold / Parts</h4>
                        <span id="count-on-hold" class="px-2 py-0.5 rounded-full text-xs font-bold bg-amber-200 dark:bg-amber-900/60">0</span>
                    </div>
                    <div id="kanban-on-hold" class="space-y-3 flex-1 overflow-y-auto max-h-[650px]"></div>
                </div>

                <div class="bg-emerald-50/50 dark:bg-slate-800/50 p-4 rounded-xl border border-emerald-200/60 dark:border-slate-700/60 flex flex-col min-h-[500px]">
                    <div class="flex justify-between items-center mb-3">
                        <h4 class="font-bold text-xs uppercase tracking-wider text-emerald-600 dark:text-emerald-400 flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span> Completed</h4>
                        <span id="count-completed" class="px-2 py-0.5 rounded-full text-xs font-bold bg-emerald-200 dark:bg-emerald-900/60">0</span>
                    </div>
                    <div id="kanban-completed" class="space-y-3 flex-1 overflow-y-auto max-h-[650px]"></div>
                </div>
            </div>
        </section>

        <!-- TIME LOGS TAB -->
        <section id="tab-logs" class="tab-content hidden space-y-6">
            <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm space-y-4">
                <h2 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2"><i class="fa-solid fa-clock-rotate-left text-emerald-600"></i> Time Logs & Workroom History</h2>
                <div id="logs-table-body" class="space-y-2">Loading logs...</div>
            </div>
        </section>
            <!-- ========== TAB: INVENTORY ========== -->
        <section id="tab-inventory" class="tab-content hidden space-y-6">
            <div class="bg-white dark:bg-slate-800 p-4 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm flex flex-col sm:flex-row justify-between items-center gap-4">
                <div class="flex items-center space-x-2 w-full sm:w-auto">
                    <div class="relative w-full sm:w-64">
                        <i class="fa-solid fa-magnifying-glass absolute left-3 top-3 text-slate-400 text-xs"></i>
                        <input type="text" id="inv-search-input" onkeyup="Inventory.render()" placeholder="Search by name, SKU, category..." class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg pl-8 pr-3 py-1.5 text-xs focus:ring-2 focus:ring-emerald-500 outline-none">
                    </div>
                    <select id="inv-category-filter" onchange="Inventory.render()" class="bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg px-3 py-1.5 text-xs outline-none">
                        <option value="ALL">All Categories</option>
                        <option value="Ink">Ink</option>
                        <option value="Parts">Printer Parts</option>
                        <option value="Components">Laptop Components</option>
                        <option value="Cables">Cables</option>
                        <option value="Devices">Complete Devices</option>
                        <option value="Consumables">Consumables</option>
                        <option value="Other">Other</option>
                    </select>
                    <select id="inv-status-filter" onchange="Inventory.render()" class="bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg px-3 py-1.5 text-xs outline-none">
                        <option value="ALL">All Stock</option>
                        <option value="LOW">Low Stock</option>
                        <option value="OUT">Out of Stock</option>
                        <option value="HEALTHY">Healthy</option>
                    </select>
                </div>

                    <button onclick="App.switchTab('inventory-reports')" class="bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 text-slate-700 dark:text-slate-200 text-xs font-semibold px-3 py-2 rounded-lg transition flex items-center gap-1.5">
                        <i class="fa-solid fa-chart-line text-emerald-500"></i> View Reports
                    </button>
                <div class="flex items-center gap-2 w-full sm:w-auto justify-end">
                    <button onclick="Inventory.refresh()" class="bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 text-slate-700 dark:text-slate-200 text-xs font-semibold px-3 py-2 rounded-lg transition flex items-center gap-1.5"><i class="fa-solid fa-rotate"></i> Refresh</button>
                    <button onclick="Inventory.openAddItem()" class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold px-4 py-2 rounded-lg shadow-sm flex items-center gap-1.5"><i class="fa-solid fa-plus"></i> New Item</button>
                </div>
            </div>
            <div id="inv-stats-bar" class="grid grid-cols-2 md:grid-cols-4 gap-3"></div>
            <div id="inv-items-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                <p class="text-xs text-slate-400 italic col-span-full text-center py-6">Loading...</p>
            </div>
        </section>

        <!-- ========== TAB: INVENTORY REPORTS ========== -->
        <section id="tab-inventory-reports" class="tab-content hidden space-y-6">
            <div class="bg-white dark:bg-slate-800 p-4 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm flex flex-col sm:flex-row justify-between items-center gap-4">
                <div>
                    <h2 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2"><i class="fa-solid fa-chart-line text-emerald-600"></i> Inventory Reports</h2>
                    <p class="text-xs text-slate-500">Revenue, profit, stock movement and reconciliation.</p>
                </div>

                <button onclick="App.switchTab('inventory')" class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold px-4 py-2 rounded-xl transition shadow flex items-center gap-2">
                    <i class="fa-solid fa-arrow-left"></i> Back to Stock
                </button>
                <div class="flex items-center gap-2">
                    <button onclick="InventoryReports.exportSalesCSV()" class="bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 text-slate-700 dark:text-slate-200 text-xs font-semibold px-3 py-2 rounded-lg transition flex items-center gap-1.5"><i class="fa-solid fa-file-csv text-emerald-500"></i> Export CSV</button>
                    <button onclick="InventoryReports.refresh()" class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold px-3 py-2 rounded-lg transition flex items-center gap-1.5"><i class="fa-solid fa-rotate"></i> Refresh</button>
                </div>
            </div>
            <div id="inv-summary-cards" class="grid grid-cols-2 md:grid-cols-4 gap-3"></div>
            <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm space-y-4">
                <h3 class="font-bold text-sm text-slate-900 dark:text-white flex items-center gap-2"><i class="fa-solid fa-cart-shopping text-emerald-600"></i> Sales & Repair Usage</h3>
                <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-700">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-slate-100 dark:bg-slate-900/80 text-slate-600 dark:text-slate-300 uppercase font-semibold"><tr><th class="p-3">Date</th><th class="p-3">Item</th><th class="p-3">Type</th><th class="p-3 text-right">Qty</th><th class="p-3 text-right">Unit</th><th class="p-3 text-right">Total</th><th class="p-3 text-right">Profit</th><th class="p-3">Client</th><th class="p-3">Sold By</th></tr></thead>
                        <tbody id="inv-sales-tbody" class="divide-y divide-slate-200 dark:divide-slate-700 font-medium"><tr><td colspan="9" class="p-6 text-center text-slate-400 italic">Loading...</td></tr></tbody>
                    </table>
                </div>
            </div>
            <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm space-y-4">
                <h3 class="font-bold text-sm text-slate-900 dark:text-white flex items-center gap-2"><i class="fa-solid fa-truck-arrow-right text-blue-600"></i> Restock / Purchases</h3>
                <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-700">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-slate-100 dark:bg-slate-900/80 text-slate-600 dark:text-slate-300 uppercase font-semibold"><tr><th class="p-3">Date</th><th class="p-3">SKU</th><th class="p-3 text-right">Qty</th><th class="p-3 text-right">Cost</th><th class="p-3 text-right">Total</th><th class="p-3">Supplier</th><th class="p-3">Invoice</th><th class="p-3">By</th></tr></thead>
                        <tbody id="inv-purchases-tbody" class="divide-y divide-slate-200 dark:divide-slate-700 font-medium"><tr><td colspan="8" class="p-6 text-center text-slate-400 italic">Loading...</td></tr></tbody>
                    </table>
                </div>
            </div>
            <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm space-y-4">
                <h3 class="font-bold text-sm text-slate-900 dark:text-white flex items-center gap-2"><i class="fa-solid fa-clipboard-check text-amber-600"></i> Reconciliation</h3>
                <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-700">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-slate-100 dark:bg-slate-900/80 text-slate-600 dark:text-slate-300 uppercase font-semibold"><tr><th class="p-3">Date</th><th class="p-3">SKU</th><th class="p-3">Item</th><th class="p-3 text-right">System</th><th class="p-3 text-right">Counted</th><th class="p-3 text-right">Variance</th><th class="p-3">Note</th><th class="p-3">By</th></tr></thead>
                        <tbody id="inv-recons-tbody" class="divide-y divide-slate-200 dark:divide-slate-700 font-medium"><tr><td colspan="8" class="p-6 text-center text-slate-400 italic">Loading...</td></tr></tbody>
                    </table>
                </div>
            </div>
        </section>
    </main>

        <!-- ================= MOBILE NAVIGATION (bottom bar) ================= -->
    <nav class="md:hidden fixed bottom-0 left-0 right-0 bg-white dark:bg-slate-800 border-t border-slate-200 dark:border-slate-700 flex justify-around p-1.5 z-40 shadow-lg">
        <button onclick="App.switchTab('dashboard'); Dashboard.refresh();" data-tab="dashboard"
