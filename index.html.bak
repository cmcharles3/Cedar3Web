                    <button onclick="App.switchTab('inventory-reports')" data-tab="inventory-reports" class="nav-btn px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-150 flex items-center space-x-2 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white">
